(ns pwgen.entropy
  "Entropy accounting (SPEC §3, §5).

  Entropy here is not a heuristic — it is the exact size of the space the
  generator draws from, expressed in bits (log2 of the number of equally
  likely outcomes). Because words are drawn INDEPENDENTLY and WITH
  REPLACEMENT from a list of K words, N words give exactly K^N outcomes,
  i.e. N × log2(K) bits. A D-digit block gives 10^D outcomes = D × log2(10)
  bits. Deterministic transformations (capitalising the first word, the
  separator choice, digit placement) multiply the outcome count by 1 and
  therefore contribute ZERO bits — we never count them (SPEC §3; the one
  randomised option, :random capitalisation, is conservatively counted as 0
  too).

  Why floors matter: a policy's :entropy-floor-bits is the minimum the
  generator will accept. The floor is checked against the FILTERED list
  size — name-token exclusion shrinks K, and honest accounting must use the
  list actually drawn from."
  )

(defn log2
  "Base-2 logarithm."
  [x]
  (/ (Math/log x) (Math/log 2)))

(defn words-bits
  "Bits contributed by `n` independent draws (with replacement) from a list
  of `k` words: n × log2(k)."
  [k n]
  (* n (log2 k)))

(defn digits-bits
  "Bits contributed by a fixed-width block of `d` uniform decimal digits:
  d × log2(10) ≈ 3.32 per digit."
  [d]
  (* d (log2 10)))

(defn passphrase-bits
  "Total bits for a passphrase: word draws plus the optional digit block.
  `digit-count` may be nil."
  [k n digit-count]
  (+ (words-bits k n)
     (if digit-count (digits-bits digit-count) 0)))

(defn min-words-for-floor
  "The smallest word count in [requested, max-words] whose total entropy
  meets `floor-bits`, or nil when even max-words falls short.

  This implements SPEC §5's rule that generation RAISES the word count
  within the policy's bounds to satisfy the floor, and refuses (nil → the
  caller errors) when it cannot."
  [k floor-bits digit-count requested max-words]
  (loop [n requested]
    (cond
      (>= (passphrase-bits k n digit-count) floor-bits) n
      (< n max-words) (recur (inc n))
      :else nil)))
