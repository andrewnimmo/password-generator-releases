(ns pwgen.charset
  "Keyboard-invariance derivation and charset tiers (SPEC §4).

  The keyboard-safety guarantee — a generated password types correctly even
  when the physical keyboard and the configured layout disagree — reduces to
  a character-set question: which characters sit on the same physical key in
  every layout we cover? Rather than hard-coding the answer, this namespace
  DERIVES it from resources/layouts.edn (embedded at compile time), and the
  test suite asserts the derivation matches the 20 letters documented in
  SPEC §4. Add a layout to the data file and the derivation — and therefore
  the product's guarantee — updates or fails loudly.

  ClojureScript note (teaching): Clojure has a character type (\\a), but
  ClojureScript does not — seq'ing a string yields single-character STRINGS
  in JS. To keep this namespace portable we avoid character literals and
  work with sets built from strings; membership tests then behave the same
  on both platforms."
  (:require [pwgen.i18n :as i18n]
            #?(:clj [pwgen.macros :refer [inline-edn]]))
  #?(:cljs (:require-macros [pwgen.macros :refer [inline-edn]])))

(def layouts
  "The layout compatibility set, straight from resources/layouts.edn."
  (inline-edn "layouts.edn"))

(def ^:private ascii-lower (set (seq "abcdefghijklmnopqrstuvwxyz")))

(defn derive-invariant-letters
  "Returns the set of letters that occupy the same physical key position in
  every given layout.

  Row strings are position-aligned (see layouts.edn): comparing index j of
  row i across layouts compares one physical key. A position contributes a
  letter iff every layout produces the SAME character there and that
  character is a-z."
  [layout-maps]
  (let [row-count (count (:rows (first layout-maps)))]
    (set
     (for [i (range row-count)
           :let [rows (map #(nth (:rows %) i) layout-maps)
                 width (apply min (map count rows))]
           j (range width)
           :let [chars-at-j (map #(nth (seq %) j) rows)]
           :when (and (apply = chars-at-j)
                      (contains? ascii-lower (first chars-at-j)))]
       (first chars-at-j)))))

(def invariant-letters
  "The derived invariant letter set — SPEC §4 documents this as exactly
  20 letters (e r t u i o p / s d f g h j k l / x c v b n); the test suite
  holds the two in lockstep."
  (derive-invariant-letters (vals (:layouts layouts))))

(defn digits-position-invariant?
  "False in the shipped layout set: digits share physical keys everywhere,
  but AZERTY produces symbols unshifted — the data itself records why the
  :invariant-digits tier carries a caveat (SPEC §4)."
  []
  (apply = (map :digits-unshifted (vals (:layouts layouts)))))

(def ^:private invariant-lower-str (apply str (sort invariant-letters)))
(def ^:private standard-lower-str "abcdefghijklmnopqrstuvwxyz")
(def ^:private digits-str "0123456789")

(defn- charset
  "Builds a membership set from strings: the lower-case letters, their
  upper-case forms (Shift works identically on every layout, so case is
  free), and any extra characters."
  [lower-str extra-str]
  (set (seq (str lower-str (i18n/upper-case lower-str) extra-str))))

(def tiers
  "Tier keyword -> set of permitted characters (SPEC §4 table).

  :invariant        the 20 derived letters, both cases, and space.
  :invariant-digits :invariant plus 0-9 (digits need Shift on AZERTY — the
                    documented caveat; used only where a policy demands a
                    digit class, e.g. AD's 3-of-4).
  :standard         full ASCII letters + digits + space. Typeable on any
                    correctly-configured layout but NOT mismatch-safe;
                    explicit opt-out that the UI must flag."
  {:invariant        (charset invariant-lower-str " ")
   :invariant-digits (charset invariant-lower-str (str digits-str " "))
   :standard         (charset standard-lower-str (str digits-str " "))})

(defn tier-chars
  "The permitted character set for `tier`, or nil for an unknown tier."
  [tier]
  (get tiers tier))

(defn conforms?
  "True when every character of `s` is permitted by `tier`."
  [tier s]
  (let [allowed (tier-chars tier)]
    (boolean (and allowed (every? allowed (seq s))))))
