(ns pwgen.specs
  "Password specifications: policy as data, validated by malli (SPEC §5).

  A specification is an EDN map describing WHAT a password policy demands —
  never HOW to generate it (that is pwgen.core's job). The built-in specs
  live in resources/specs.edn; user-supplied specs go through the very same
  schema via parse-spec. The schema here is normative: if specs.edn and this
  schema disagree, the test suite fails.

  malli in one paragraph (teaching): a malli schema is itself plain data —
  vectors like [:map [:id :keyword]] — interpreted by the malli library to
  validate values, EXPLAIN failures in humane language, and even generate
  random conforming values (which our property-based tests exploit). Because
  schemas are data, they work identically in Clojure and ClojureScript."
  (:require [malli.core :as m]
            [malli.error :as me]
            #?(:clj [clojure.edn :as edn]
               :cljs [cljs.reader :as edn])
            #?(:clj [pwgen.macros :refer [inline-edn]]))
  #?(:cljs (:require-macros [pwgen.macros :refer [inline-edn]])))

(def Tier
  "The charset tiers of SPEC §4."
  [:enum :invariant :invariant-digits :standard])

(def BoundedRange
  "A {:min .. :max .. :default ..} map with min <= default <= max."
  [:and
   [:map {:closed true}
    [:min pos-int?]
    [:max pos-int?]
    [:default pos-int?]]
   [:fn {:error/message "must satisfy min <= default <= max"}
    (fn [{:keys [min max default]}] (<= min default max))]])

(def Separator
  [:and
   [:map {:closed true}
    [:allowed [:vector {:min 1} [:enum :space :none]]]
    [:default [:enum :space :none]]]
   [:fn {:error/message ":default must be one of :allowed"}
    (fn [{:keys [allowed default]}] (some #(= default %) allowed))]])

(def WordsSpec
  "A passphrase-mode specification."
  [:and
   [:map {:closed true}
    [:id :keyword]
    [:i18n-key :keyword]
    [:mode [:= :words]]
    [:charset-tier Tier]
    [:words BoundedRange]
    [:separator Separator]
    [:capitalization [:enum :first :random :all :none]]
    [:digits {:optional true}
     [:map {:closed true}
      [:count [:int {:min 1 :max 4}]]
      [:placement [:enum :suffix :prefix]]]]
    [:length {:optional true}
     [:map {:closed true}
      [:min {:optional true} pos-int?]
      [:max {:optional true} pos-int?]]]
    [:exclude-name-tokens {:optional true}
     [:map {:closed true}
      [:min-token-length pos-int?]]]
    [:entropy-floor-bits [:>= 0]]]
   ;; Cross-field rule: a digit block demands a tier that permits digits.
   ;; Without this, generation could never produce a conforming password and
   ;; would fail only at runtime — schemas should catch impossibility early.
   [:fn {:error/message "a :digits block requires :charset-tier :invariant-digits or :standard"}
    (fn [{:keys [digits charset-tier]}]
      (or (nil? digits) (not= charset-tier :invariant)))]])

(def PinSpec
  "A digits-only specification. Structurally different from :words mode —
  which is why the top-level schema dispatches on :mode."
  [:map {:closed true}
   [:id :keyword]
   [:i18n-key :keyword]
   [:mode [:= :pin]]
   [:length BoundedRange]
   [:entropy-floor-bits [:>= 0]]])

(def PasswordSpec
  "The normative schema: dispatches on :mode to the right shape.
  (:multi is malli's tagged-union: it picks the branch whose dispatch value
  matches, then validates against that branch's schema.)"
  [:multi {:dispatch :mode}
   [:words WordsSpec]
   [:pin PinSpec]])

(def built-in
  "id -> spec map, embedded from resources/specs.edn at compile time.
  Every entry is validated by the test suite against PasswordSpec."
  (inline-edn "specs.edn"))

(def spec-ids
  "Built-in specification ids, in the order specs.edn declares them.
  (Small EDN maps read as array-maps, which preserve insertion order —
  convenient here, but never rely on ordering for maps that might grow
  past 8 entries.)"
  (vec (keys built-in)))

(defn get-spec
  "The built-in spec for `id`, or nil."
  [id]
  (get built-in id))

(defn errors
  "nil when `spec` is valid; otherwise a humanised map of what is wrong."
  [spec]
  (when-not (m/validate PasswordSpec spec)
    (me/humanize (m/explain PasswordSpec spec))))

(defn valid? [spec] (nil? (errors spec)))

(defn parse-spec
  "Parses an EDN string into a validated spec.

  Uses the EDN reader (never read-string of clojure.core / eval): EDN
  parsing evaluates nothing, so untrusted spec files cannot execute code.
  Throws ex-info {:error :invalid-spec} with humanised details on failure."
  [edn-string]
  (let [spec (try (edn/read-string edn-string)
                  (catch #?(:clj Exception :cljs :default) e
                    (throw (ex-info "Unreadable specification EDN"
                                    {:error :invalid-spec
                                     :details (ex-message e)}))))]
    (if-let [errs (errors spec)]
      (throw (ex-info "Invalid password specification"
                      {:error :invalid-spec :details errs}))
      spec)))
