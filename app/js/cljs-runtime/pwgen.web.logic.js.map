(ns pwgen.web.logic
  "Pure state logic for the WEB shell — the browser twin of
  pwgen.desktop.logic, sharing every judgement through pwgen.ui and
  differing only where a browser genuinely differs (SPEC §11):

  - persistence is browser storage, written per change as an effect
    (a tab has no reliable 'closing' moment)
  - no clipboard auto-clear (a page cannot politely check whether the
    clipboard still holds its value), no update check (a web page is
    always its latest version), no native menus, no window geometry

  `handle` is the same pure {:state :effects} shape; effects are carried
  out by pwgen.web.app/perform!."
  (:require [pwgen.i18n :as i18n]
            [pwgen.names :as names]
            [pwgen.ui :as ui]))

(defn initial-state
  "The state to open with: saved (sanitised) browser settings, then the
  browser's own language — same precedence and same explicit-choice rule
  for persisting language as the desktop."
  [saved]
  (let [s (ui/sanitize-settings saved)
        locale (or (:language s) (i18n/detect-locale))]
    {:locale locale
     :locale-chosen? (some? (:language s))
     :spec-id (or (:spec-id s) :ad-entra)
     :wordlist-locale (or (:wordlist-locale s) locale)
     :list nil
     :loading? true
     :word-count (:word-count s)
     :separator (:separator s)
     :pin-length nil
     :name ""
     :result nil
     :error nil
     :copied? false
     :theme (:theme s)
     :dialog nil
     :rng nil
     :wordlist-locales []}))

(defn session-settings
  "What browser storage remembers — same explicit-choice and
  divergence-only rules as the desktop's settings file."
  [state]
  {:language (when (:locale-chosen? state) (:locale state))
   :wordlist-locale (when (not= (:wordlist-locale state) (:locale state))
                      (:wordlist-locale state))
   :spec-id (:spec-id state)
   :word-count (:word-count state)
   :separator (:separator state)
   :theme (:theme state)})

(defn- clear-output [state]
  (assoc state :result nil :error nil :copied? false))

(defn handle
  "One event in, {:state ... :effects [...]} out; unknown events pass the
  state through untouched."
  [state event]
  (case (:event/type event)
    :set-spec {:state (-> state (assoc :spec-id (:value event)
                                       :word-count nil :separator nil :pin-length nil)
                          clear-output)
               :effects [[:reload-list] [:persist]]}

    :set-wordlist-locale {:state (-> state (assoc :wordlist-locale (:value event))
                                     clear-output)
                          :effects [[:reload-list] [:persist]]}

    :manifest-loaded {:state (assoc state :wordlist-locales (:locales event))}
    :list-loading {:state (assoc state :loading? true)}
    :list-loaded {:state (assoc state :list (:list event) :loading? false)}

    :set-word-count (if (ui/word-count-selectable? state (:value event))
                      {:state (-> state (assoc :word-count (:value event)) clear-output)
                       :effects [[:persist]]}
                      {:state state})
    :set-pin-length {:state (-> state (assoc :pin-length (:value event)) clear-output)}
    :set-separator {:state (-> state (assoc :separator (:value event)) clear-output)
                    :effects [[:persist]]}

    :name-changed {:state (-> state (assoc :name (names/sanitize-name (:value event)))
                              clear-output)}

    :generate-requested {:state (ui/generate state)}

    :copy-requested (if-let [pwd (get-in state [:result :password])]
                      {:state (assoc state :copied? true)
                       :effects [[:copy pwd]]}
                      {:state state})
    :copied-reset {:state (assoc state :copied? false)}

    :language-picked {:state (-> state (assoc :locale (:value event)
                                              :wordlist-locale (:value event)
                                              :locale-chosen? true)
                                 clear-output)
                      :effects [[:reload-list] [:persist] [:set-page-lang]]}

    :theme-changed {:state (assoc state :theme (:theme event))
                    :effects [[:apply-theme (:theme event)] [:persist]]}

    :about-toggled {:state (assoc state :dialog (when-not (= :about (:dialog state)) :about))}
    :help-toggled {:state (assoc state :dialog (when-not (= :help (:dialog state)) :help))}
    :dialog-closed {:state (assoc state :dialog nil)}

    {:state state}))
