(ns pwgen.web.views
  "The page as a pure function of state — Reagent hiccup mirroring the
  desktop window (SPEC §11): same header ?/i buttons, same control order,
  same password card, same About/Help overlays with About hosting the
  options that shape the page. Structure and class names track
  public/css/app.css, whose visual language is the desktop stylesheet's."
  (:require [pwgen.i18n :as i18n]
            [pwgen.specs :as specs]
            [pwgen.ui :as ui]
            [pwgen.version :as version]))

;; Branding facts for the web shell. The desktop reads branding.edn at
;; runtime; a browser has no classpath, so the same constants live here —
;; single-sourced enough while the values also ship in the About tests.
(def app-name "Password Generator")
(def copyright "Copyright © 2026 Andrew David Nimmo")
(def contact "contact+password.generator@nimmo.dev")

(defn- tr [state k & args]
  (apply i18n/tr (:locale state) k args))

(defn- icon-button [glyph tooltip on-click]
  [:button.icon-button {:title tooltip :on-click on-click} glyph])

(defn- header-bar [state dispatch]
  [:div.header-bar
   [icon-button "?" (tr state :action/help) #(dispatch {:event/type :help-toggled})]
   [icon-button "i" (tr state :about/title app-name) #(dispatch {:event/type :about-toggled})]])

(defn- select-control
  "A native <select>, the browser's combo-box: items are values, labels via
  label-fn, and the change handler receives the picked ITEM."
  [{:keys [items value label-fn on-pick]}]
  [:select {:value (pr-str value)
            :on-change #(on-pick (some (fn [item] (when (= (pr-str item) (.. % -target -value)) item))
                                       items))}
   (for [item items]
     ^{:key (pr-str item)} [:option {:value (pr-str item)} (label-fn item)])])

(defn- pills [options]
  [:div.pills
   (for [[i {:keys [text selected? on-click]}] (map-indexed vector options)]
     ^{:key i}
     [:button.pill {:class (when selected? "selected")
                    ;; Same radio rule as the desktop's capture filter: a
                    ;; selected pill cannot be clicked off.
                    :on-click (when-not selected? on-click)}
      text])])

(defn- spec-section [state dispatch]
  [:div.field
   [:label.field-label (tr state :label/spec)]
   [select-control {:items specs/spec-ids
                    :value (:spec-id state)
                    :label-fn #(tr state (keyword "spec" (name %)))
                    :on-pick #(dispatch {:event/type :set-spec :value %})}]
   [:p.hint (tr state (keyword "spec.desc" (name (:spec-id state))))]])

(defn- word-controls [state dispatch]
  [:div.controls-row
   [:div.field
    [:label.field-label (tr state :label/words)]
    [select-control {:items (ui/word-count-options state)
                     :value (ui/effective-word-count state)
                     :label-fn str
                     :on-pick #(dispatch {:event/type :set-word-count :value %})}]]
   [:div.field
    [:label.field-label (tr state :label/separator)]
    [pills (for [sep (get-in (ui/spec state) [:separator :allowed])]
             {:text (tr state (keyword "sep" (name sep)))
              :selected? (= sep (ui/effective-separator state))
              :on-click #(dispatch {:event/type :set-separator :value sep})})]]
   [:div.field
    [:label.field-label (tr state :label/wordlist)]
    [select-control {:items (:wordlist-locales state)
                     :value (:wordlist-locale state)
                     :label-fn #(i18n/tr % :locale/name)
                     :on-pick #(dispatch {:event/type :set-wordlist-locale :value %})}]]])

(defn- pin-controls [state dispatch]
  (let [{:keys [min max]} (:length (ui/spec state))]
    [:div.field
     [:label.field-label (tr state :label/pin-length)]
     [select-control {:items (vec (range min (inc max)))
                      :value (ui/effective-pin-length state)
                      :label-fn str
                      :on-pick #(dispatch {:event/type :set-pin-length :value %})}]]))

(defn- name-section [state dispatch]
  [:div.field
   [:label.field-label (tr state :label/name)]
   ;; No "use system username" here: a browser cannot know it (SPEC §11:
   ;; the web mirrors the desktop within what a browser allows).
   [:input {:type "text"
            :value (:name state)
            :placeholder (tr state :name/prompt)
            :on-change #(dispatch {:event/type :name-changed
                                   :value (.. % -target -value)})}]
   [:p.hint (tr state :name/why)]])

(defn- entropy-section [state]
  (let [{:keys [bits floor unreachable?]} (ui/preview state)]
    [:div.entropy
     [:div.meter {:class (when unreachable? "meter-bad")}
      [:div.meter-fill {:style {:width (str (if unreachable? 2
                                                (min 100 (* 100 (/ bits 96.0)))) "%")}}]]
     (cond
       (:loading? state)
       [:p.hint (tr state :note/loading)]
       unreachable?
       [:div.callout.danger [:p (tr state :entropy/unreachable)]]
       :else
       [:p.hint (tr state :entropy/meter
                    (.toFixed bits 1) floor)])
     (when (get-in state [:list :fallback?])
       [:p.hint (tr state :note/list-fallback)])]))

(defn- password-card [state dispatch]
  (when-let [result (:result state)]
    [:div.password-card
     [:div.password-row
      [:span.password-text (:password result)]
      [:button.copy-btn {:class (when (:copied? state) "copied")
                         :title (tr state :password/copy-tip)
                         :on-click #(dispatch {:event/type :copy-requested})}
       (tr state :btn/copy)]]
     [:p.password-meta {:class (when (:copied? state) "copied-note")}
      (if (:copied? state)
        (str "✓ " (tr state :btn/copied))
        (tr state :entropy/meter
            (.toFixed (:bits result) 1)
            (:entropy-floor-bits (specs/get-spec (:spec-id result)))))]]))

(defn- error-panel [state]
  (when-let [error (:error state)]
    [:div.callout.danger
     [:p (apply i18n/tr (:locale state) (ui/error->message error))]]))

(defn- footer [state dispatch]
  [:div.footer-bar
   [:button.accent {:disabled (or (:loading? state)
                                  (:unreachable? (ui/preview state)))
                    :on-click #(dispatch {:event/type :generate-requested})}
    (tr state :btn/generate)]])

;; ── Overlays ───────────────────────────────────────────────────────────────

(defn- overlay [close! & children]
  [:div.overlay {:on-click #(when (= (.-target %) (.-currentTarget %)) (close!))}
   (into [:div.dialog-card] children)])

(defn- dict-entry [state]
  [:div.dict-entry
   [:div.dict-head
    [:span.dict-word (tr state :about/dict-word)]
    [:span.dict-pron (tr state :about/dict-pron)]
    [:span.dict-pos (tr state :about/dict-pos)]]
   [:p.dict-sense (tr state :about/dict-sense-1)]
   [:p.dict-sense (tr state :about/dict-sense-2)]
   [:p.dict-note (tr state :about/dict-note)]])

(defn- about-dialog [state dispatch]
  (let [close! #(dispatch {:event/type :dialog-closed})]
    [overlay close!
     [:div.about-head
      [:img.about-icon {:src "icons/icon-192.png" :alt ""}]
      [:div
       [:div.title-text (tr state :about/title app-name)]
       [:p.hint (tr state :about/tagline)]]]
     [dict-entry state]
     [:p (tr state :about/version (str version/version " (web)"))]
     [:p.hint copyright]
     [:p.hint (tr state :about/licence)]
     ;; No bundled-runtime notice and no update section here: a web page
     ;; ships no Java runtime and is always its current version (SPEC §11:
     ;; within what a browser allows). No clipboard auto-clear either — a
     ;; page cannot politely verify clipboard ownership.
     [:p.hint (tr state :about/wordlist-licences)]
     [:p.hint (tr state :about/contact) ": "
      [:a {:href (str "mailto:" contact "?subject=" app-name " " version/version " (web)")}
       contact]]
     [:p.hint (tr state :about/made-with)]
     [:hr]
     [:div.field
      [:label (tr state :about/language)]
      [select-control {:items i18n/locales
                       :value (:locale state)
                       :label-fn #(i18n/tr % :locale/name)
                       :on-pick #(dispatch {:event/type :language-picked :value %})}]
      [:p.hint (tr state :about/language-hint)]]
     [:div.field
      [:label (tr state :about/theme)]
      [pills [{:text (tr state :about/theme-system) :selected? (= (:theme state) :system)
               :on-click #(dispatch {:event/type :theme-changed :theme :system})}
              {:text (tr state :about/theme-light) :selected? (= (:theme state) :light)
               :on-click #(dispatch {:event/type :theme-changed :theme :light})}
              {:text (tr state :about/theme-dark) :selected? (= (:theme state) :dark)
               :on-click #(dispatch {:event/type :theme-changed :theme :dark})}]]]
     [:div.dialog-actions
      [:button.accent {:on-click close!} (tr state :action/close)]]]))

(defn- help-dialog [state dispatch]
  (let [close! #(dispatch {:event/type :dialog-closed})]
    [overlay close!
     [:div.title-text (tr state :help/title)]
     (for [[q a] [[:help/q-words :help/a-words]
                  [:help/q-entropy :help/a-entropy]
                  [:help/q-keyboard :help/a-keyboard]
                  [:help/q-name :help/a-name]
                  [:help/q-specs :help/a-specs]]]
       ^{:key q}
       [:div.help-topic
        [:p.headline (tr state q)]
        [:p.hint (tr state a)]])
     [:div.dialog-actions
      [:button.accent {:on-click close!} (tr state :action/close)]]]))

;; ── Root ───────────────────────────────────────────────────────────────────

(defn root [*state dispatch]
  (let [state @*state]
    [:div.app
     [:div.window-body
      [header-bar state dispatch]
      [spec-section state dispatch]
      (if (ui/pin-mode? state)
        [pin-controls state dispatch]
        [:<>
         [word-controls state dispatch]
         [name-section state dispatch]])
      [:hr]
      [entropy-section state]
      [password-card state dispatch]
      [error-panel state]]
     [footer state dispatch]
     (case (:dialog state)
       :about [about-dialog state dispatch]
       :help [help-dialog state dispatch]
       nil)]))
