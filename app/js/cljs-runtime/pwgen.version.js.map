(ns pwgen.version
  "The project version, single-sourced from resources/branding.edn — the
  About overlay, build.clj and the packaging metadata all read the same
  value, so they can never disagree."
  #?(:clj (:require [pwgen.macros :refer [inline-edn]])
     :cljs (:require-macros [pwgen.macros :refer [inline-edn]])))

(def version (:version (inline-edn "branding.edn")))
