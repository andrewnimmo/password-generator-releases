(ns pwgen.i18n
  "Locale discipline (SPEC §8) — the ONLY namespace allowed to call the
  platform's case-conversion functions directly (clj-kondo enforces this).

  Why: on the JVM, String.toLowerCase()/toUpperCase() without an explicit
  Locale use the machine's default locale. Under Turkish (tr_TR) the letter
  I lowercases to the dotless ı, so (= (lower \"TITLE\") \"title\") is
  FALSE on a Turkish machine — a classic source of latent bugs in string
  comparisons, and in our case a direct threat to the name-token exclusion
  rule (pwgen.names compares lowercased strings). Passing Locale/ROOT gives
  locale-independent, reproducible behaviour everywhere.

  In JavaScript the plain toLowerCase()/toUpperCase() are already
  locale-independent by spec (the locale-sensitive variants are the separate
  toLocaleLowerCase/toLocaleUpperCase), so the cljs branches simply call
  them — the reader conditionals below exist to document and isolate that
  asymmetry in one place.

  This namespace also owns the UI translations (resources/i18n.edn, embedded
  at compile time) and the `tr` lookup with its :en fallback chain."
  (:require #?(:clj [pwgen.macros :refer [inline-edn]])
            [clojure.string :as str])
  #?(:cljs (:require-macros [pwgen.macros :refer [inline-edn]]))
  #?(:clj (:import [java.util Locale])))

(defn lower-case
  "Locale-independent lower-casing (Locale/ROOT semantics on the JVM)."
  [s]
  #?(:clj (.toLowerCase ^String s Locale/ROOT)
     :cljs (.toLowerCase ^js s)))

(defn upper-case
  "Locale-independent upper-casing (Locale/ROOT semantics on the JVM)."
  [s]
  #?(:clj (.toUpperCase ^String s Locale/ROOT)
     :cljs (.toUpperCase ^js s)))

#?(:clj
   (defn format-root
     "clojure.core/format with Locale/ROOT — because format's %f obeys the
     JVM default locale too: on a comma-decimal machine (format \"%.1f\" 54.6)
     prints \"54,6\". Caught live in this very project's CLI on 2026-08-31;
     see docs/VERIFICATION.md. JVM-only: cljs has no format."
     [fmt & args]
     (String/format Locale/ROOT fmt (to-array args))))

(defn capitalize-first
  "Upper-cases only the first character, leaving the rest untouched.

  Deliberately narrower than clojure.string/capitalize, which also
  lower-cases the remainder (locale-sensitively, on the JVM). Our word lists
  are already lower-case; touching only the first character keeps the
  transformation minimal and predictable."
  [s]
  (if (or (nil? s) (= s ""))
    s
    (str (upper-case (subs s 0 1)) (subs s 1))))

;; ---------------------------------------------------------------------------
;; UI translations (SPEC §8)
;; ---------------------------------------------------------------------------

(def translations
  "locale -> key -> string, from resources/i18n.edn. The test suite enforces
  that every locale carries exactly the :en key set — no half-translated
  releases."
  (inline-edn "i18n.edn"))

(def locales
  "Supported UI locales, alphabetical."
  (vec (sort (keys translations))))

(defn tr
  "Looks up key `k` for `locale`, falling back to English, then to the key's
  name (so a missing string is visible, never a crash). Positional
  arguments replace {0}, {1}, ... in the string."
  [locale k & args]
  (let [template (or (get-in translations [locale k])
                     (get-in translations [:en k])
                     (str k))]
    (reduce (fn [s [i arg]]
              (str/replace s (str "{" i "}") (str arg)))
            template
            (map-indexed vector args))))

(defn detect-locale
  "The UI locale for this machine: the platform's language if we ship it,
  else English. Read ONCE at startup (the JVM's default locale never changes
  mid-process — the legacy app polled it every 2 s for nothing)."
  []
  (let [lang #?(:clj (.getLanguage (Locale/getDefault))
                :cljs (subs (or (.-language js/navigator) "en") 0 2))
        k (keyword lang)]
    (if (contains? translations k) k :en)))
