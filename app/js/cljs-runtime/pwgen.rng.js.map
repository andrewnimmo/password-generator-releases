(ns pwgen.rng
  "Cryptographically secure randomness (SPEC §3).

  Everything random in this project flows through the RandomSource protocol
  below, for two reasons:

  1. SECURITY. clojure.core's rand/rand-int/rand-nth/shuffle sit on
     predictable PRNGs (java.util.Random on the JVM, Math.random in JS).
     Observing a little output lets an attacker reconstruct their internal
     state and predict every future \"random\" value — disqualifying for a
     password generator. clj-kondo bans them project-wide; the secure
     sources are java.security.SecureRandom (JVM) and the Web Crypto API's
     crypto.getRandomValues (browsers, and Node 19+ where `crypto` is a
     global).

  2. TESTABILITY. Because the source is injected as a value, tests can pass
     a deterministic stand-in (see pwgen.test-support) and assert exact
     outputs, while production code never touches anything but the secure
     implementations here.")

(defprotocol RandomSource
  (uniform-int [this bound]
    "Returns a uniformly distributed integer in [0, bound). bound must be a
    positive integer."))

#?(:clj
   (defn secure-rng
     "A RandomSource backed by java.security.SecureRandom.

     SecureRandom.nextInt(bound) is already uniform: the JDK performs
     rejection sampling internally, so no extra debiasing is needed here."
     []
     (let [sr (java.security.SecureRandom.)]
       (reify RandomSource
         (uniform-int [_ bound]
           (.nextInt sr (int bound))))))

   :cljs
   (defn secure-rng
     "A RandomSource backed by the Web Crypto API.

     getRandomValues hands us raw uniform 32-bit integers; mapping them onto
     an arbitrary bound needs care. The naive (mod value bound) is BIASED
     whenever bound doesn't divide 2^32 evenly — e.g. with bound 3, values
     0 and 1 would occur very slightly more often than 2, because
     2^32 = 3 × 1431655765 + 1. The fix is REJECTION SAMPLING: discard any
     draw from the final, incomplete cycle (values >= limit below) and draw
     again. Each accepted value is then exactly uniform. The retry
     probability is at most bound/2^32 — vanishingly rare in practice."
     []
     (let [crypto (or (.-crypto js/globalThis)
                      (throw (ex-info "Web Crypto API unavailable — cannot generate secure randomness"
                                      {:error :no-crypto})))
           buf (js/Uint32Array. 1)
           two32 4294967296]
       (reify RandomSource
         (uniform-int [_ bound]
           (let [limit (- two32 (mod two32 bound))]
             (loop []
               (.getRandomValues crypto buf)
               (let [v (aget buf 0)]
                 (if (< v limit)
                   (mod v bound)
                   (recur))))))))))

(defn pick
  "Draws one element from vector `v`, uniformly. The secure replacement for
  the banned rand-nth."
  [rng v]
  (nth v (uniform-int rng (count v))))
