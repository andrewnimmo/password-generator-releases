(ns pwgen.core
  "The generation engine (SPEC §3, §5, §6).

  This namespace is deliberately boring: given a validated specification, a
  word list, and a RandomSource, `generate` assembles a password and proves
  it against the spec before returning it. It performs no I/O, holds no
  state, and knows nothing about UIs — the desktop app, the web app, and
  the CLI all call exactly this function (that is the whole point of the
  .cljc core, SPEC §6).

  The flow, matching the numbered steps in generate-passphrase:
    1. sanity-check the word list against the spec's charset tier
    2. tokenise the user's name per the AD rule and pre-filter the list
    3. resolve the effective word count against the entropy floor
       (raising it within the spec's bounds when needed — SPEC §5)
    4. draw, capitalise, add the digit block, join
    5. validate the ASSEMBLED password (tier, length, no name token —
       tokens can straddle word boundaries with the :none separator,
       which is why the pre-filter alone is not enough)
    6. on validation failure, redraw (bounded attempts), else error out
       loudly — never silently return a non-conforming password."
  (:require [clojure.string :as str]
            [pwgen.charset :as charset]
            [pwgen.entropy :as entropy]
            [pwgen.i18n :as i18n]
            [pwgen.names :as names]
            [pwgen.rng :as rng]
            [pwgen.specs :as specs]))

(def ^:private max-attempts
  "Redraw budget for step 6. Failures are rare (a token straddling a word
  boundary, or a length bound missed), so 10 honest retries either succeed
  or indicate the configuration itself cannot produce a conforming password."
  10)

(defn- fail
  "Throws ex-info carrying a machine-readable :error key (the UI shells map
  these keys to translated messages) plus any diagnostic data."
  [error-key msg data]
  (throw (ex-info msg (assoc data :error error-key))))

(defn- resolve-spec
  "Accepts a spec id keyword or a full spec map; returns a validated spec."
  [spec]
  (let [spec-map (if (keyword? spec)
                   (or (specs/get-spec spec)
                       (fail :unknown-spec (str "Unknown specification: " spec)
                             {:spec-id spec :known specs/spec-ids}))
                   spec)]
    (if-let [errs (specs/errors spec-map)]
      (fail :invalid-spec "Invalid password specification" {:details errs})
      spec-map)))

(defn- resolve-separator
  [spec separator]
  (let [sep (or separator (get-in spec [:separator :default]))]
    (if (some #(= sep %) (get-in spec [:separator :allowed]))
      sep
      (fail :separator-not-allowed (str "Separator not allowed by spec: " sep)
            {:separator sep :allowed (get-in spec [:separator :allowed])}))))

(defn- separator-str [sep]
  (case sep :space " " :none ""))

(defn- digit-block
  "A fixed-width block of `d` decimal digits: ONE uniform draw from
  [0, 10^d), zero-padded. Fixed width matters for the entropy accounting
  (exactly 10^d equally likely outcomes) and keeps result lengths stable."
  [source d]
  (let [bound (apply * (repeat d 10))
        n (rng/uniform-int source bound)]
    (loop [s (str n)]
      (if (< (count s) d) (recur (str "0" s)) s))))

(defn- capitalize-words
  [rule words source]
  (case rule
    :none words
    :all (mapv i18n/capitalize-first words)
    :first (into [(i18n/capitalize-first (first words))] (rest words))
    ;; :random is the one randomised rule; SPEC §3 counts it as 0 bits
    ;; (a conservative under-count) so entropy math stays closed-form.
    :random (update words (rng/uniform-int source (count words))
                    i18n/capitalize-first)))

(defn- assemble
  [words sep-s digits placement]
  (let [body (str/join sep-s words)]
    (cond
      (nil? digits) body
      (= placement :prefix) (str digits body)
      :else (str body digits))))

(defn- generate-pin
  [spec source requested-length]
  (let [{:keys [min max default]} (:length spec)
        n (or requested-length default)]
    (when-not (<= min n max)
      (fail :length-out-of-range (str "PIN length must be between " min " and " max)
            {:length n :min min :max max}))
    {:password (apply str (repeatedly n #(rng/uniform-int source 10)))
     :bits (entropy/digits-bits n)
     :length n
     :mode :pin
     :spec-id (:id spec)}))

(defn- generate-passphrase
  [spec source wordlist name-str word-count separator]
  ;; Step 1 — the word list must exist and conform to the spec's tier.
  ;; (The word-list pipeline guarantees this for shipped lists; enforcing it
  ;; here protects against user-supplied lists with, say, accented letters.)
  (when (< (count (or wordlist [])) 2)
    (fail :wordlist-too-small "Word list must contain at least 2 words"
          {:list-size (count (or wordlist []))}))
  (when-let [bad (first (remove #(charset/conforms? (:charset-tier spec) %) wordlist))]
    (fail :wordlist-tier-mismatch
          (str "Word not permitted by charset tier " (:charset-tier spec) ": " bad)
          {:word bad :tier (:charset-tier spec)}))
  (let [tier (:charset-tier spec)
        sep (resolve-separator spec separator)
        sep-s (separator-str sep)
        ;; Step 2 — AD-style name tokens (3+ chars only; see pwgen.names).
        tokens (if-let [ex (:exclude-name-tokens spec)]
                 (names/name-tokens (or name-str "") (:min-token-length ex))
                 #{})
        flist (names/remove-token-words (vec wordlist) tokens)
        k (count flist)
        _ (when (< k 2)
            (fail :wordlist-too-small "Name filtering left too few usable words"
                  {:list-size k :tokens tokens}))
        ;; Step 3 — effective word count vs. the entropy floor. Entropy is
        ;; computed against K AFTER filtering: honest accounting uses the
        ;; list actually drawn from.
        {req-min :min req-max :max req-default :default} (:words spec)
        ;; `long` documents (to readers and to the cljs compiler's type
        ;; inference alike) that this is definitely an integer — the schema
        ;; guarantees :default exists on every validated spec.
        requested (long (or word-count req-default))
        _ (when-not (<= req-min requested req-max)
            (fail :word-count-out-of-range
                  (str "Word count must be between " req-min " and " req-max)
                  {:word-count requested :min req-min :max req-max}))
        dcount (get-in spec [:digits :count])
        floor (:entropy-floor-bits spec)
        n (long (or (entropy/min-words-for-floor k floor dcount requested req-max)
                    (fail :entropy-floor-unreachable
                          "Even the maximum word count cannot reach the entropy floor with this word list"
                          {:floor-bits floor :list-size k :max-words req-max
                           :max-bits (entropy/passphrase-bits k req-max dcount)})))
        bits (entropy/passphrase-bits k n dcount)
        len-min (get-in spec [:length :min])
        len-max (get-in spec [:length :max])]
    ;; Steps 4-6 — draw, assemble, validate, redraw if needed.
    (loop [attempt 1]
      (let [drawn (vec (repeatedly n #(rng/pick source flist)))
            cased (capitalize-words (:capitalization spec) drawn source)
            digits (when dcount (digit-block source dcount))
            pwd (assemble cased sep-s digits (get-in spec [:digits :placement]))
            ok? (and (charset/conforms? tier pwd)
                     (or (nil? len-min) (>= (count pwd) len-min))
                     (or (nil? len-max) (<= (count pwd) len-max))
                     (not (names/contains-token? pwd tokens)))]
        (cond
          ok? {:password pwd
               :bits bits
               :word-count n
               :raised? (> n requested)
               :separator sep
               :list-size k
               :mode :words
               :spec-id (:id spec)}
          (< attempt max-attempts) (recur (inc attempt))
          :else (fail :generation-failed
                      "Could not produce a conforming password — the spec's length bounds or name constraints are too tight for this word list"
                      {:attempts max-attempts :list-size k
                       :length {:min len-min :max len-max}}))))))

(defn generate
  "Generates one password. Options map:

    :spec        REQUIRED — a spec id keyword (see pwgen.specs/spec-ids)
                 or a full validated spec map
    :wordlist    vector of words (required for :words-mode specs)
    :rng         a pwgen.rng/RandomSource; defaults to a fresh secure-rng.
                 Only tests should ever pass anything else.
    :name        the user's name/username for token exclusion (optional)
    :word-count  requested word count (optional; spec default, may be
                 RAISED to meet the spec's entropy floor — :raised? in the
                 result says so)
    :separator   :space | :none (optional; spec default)
    :length      PIN length (pin-mode specs only)

  Returns {:password :bits :spec-id :mode ...} — see generate-passphrase /
  generate-pin for the mode-specific keys. Throws ex-info with a
  machine-readable :error key on any constraint violation; it never
  silently degrades."
  [{:keys [spec wordlist rng name word-count separator length]}]
  (let [source (or rng (rng/secure-rng))
        spec-map (resolve-spec spec)]
    (case (:mode spec-map)
      :pin (generate-pin spec-map source length)
      :words (generate-passphrase spec-map source wordlist name word-count separator))))
