(ns pwgen.ui
  "The shared view-model (SPEC §6): every pure judgement both shells make
  about the working state — what the spec allows, which word counts are
  offered, what the entropy preview says, how an engine error reads.

  Extracted from the desktop shell when the web twin arrived (M4): the
  legacy application triplicated exactly this logic across its desktop, web
  and mobile files, and the copies drifted. One namespace, compiled to both
  platforms, tested on both (test/pwgen/ui_test.cljc runs on the JVM and
  under Node).

  Works on the same state-map keys both shells use:
    :spec-id :wordlist-locale :list :word-count :separator :pin-length
    :name :result :error :rng"
  (:require [pwgen.core :as core]
            [pwgen.entropy :as entropy]
            [pwgen.i18n :as i18n]
            [pwgen.names :as names]
            [pwgen.specs :as specs]))

(defn spec [state] (specs/get-spec (:spec-id state)))

(defn wordlist-tier
  "Maps a spec's charset tier to the word-list tier that serves it: words
  never contain digits, so :invariant-digits draws from the :invariant list
  (the digits come from the generated digit block, not the words)."
  [charset-tier]
  (if (= charset-tier :standard) :standard :invariant))

(defn pin-mode? [state] (= :pin (:mode (spec state))))

(defn effective-separator [state]
  (or (:separator state) (get-in (spec state) [:separator :default])))

(defn effective-pin-length [state]
  (or (:pin-length state) (get-in (spec state) [:length :default])))

(defn filtered-list-size
  "How many words remain after the AD name filter — the K the entropy math
  must use (SPEC §3: honest accounting uses the list actually drawn from)."
  [state]
  (let [words (get-in state [:list :words])
        ex (:exclude-name-tokens (spec state))
        tokens (if ex (names/name-tokens (:name state) (:min-token-length ex)) #{})]
    (count (names/remove-token-words (or words []) tokens))))

(defn min-valid-word-count
  "The smallest allowed word count that meets the entropy floor with the
  current (name-filtered) list, or nil when even the maximum falls short.

  This drives the ruling of 2026-08-31: counts below it are simply not
  offered — prevention instead of an auto-raise plus a warning."
  [state]
  (let [sp (spec state)
        k (filtered-list-size state)]
    (when (>= k 2)
      (entropy/min-words-for-floor k (:entropy-floor-bits sp)
                                   (get-in sp [:digits :count])
                                   (get-in sp [:words :min])
                                   (get-in sp [:words :max])))))

(defn word-count-selectable? [state n]
  ;; `long` for the cljs compiler's type inference, as in pwgen.core.
  (if-let [m (min-valid-word-count state)]
    (>= (long n) (long m))
    false))

(defn word-count-options
  "The counts the picker OFFERS: only those meeting the entropy floor.
  When the floor is unreachable the full range is returned; the picker is
  moot then, since Generate is disabled with an explanation."
  [state]
  (let [{:keys [min max]} (:words (spec state))
        all (vec (range min (inc max)))
        valid (filterv #(word-count-selectable? state %) all)]
    (if (seq valid) valid all)))

(defn effective-word-count
  "The count generation will use: the user's choice (or the spec default),
  climbing to the smallest valid count when the list has shrunk under it —
  visibly, in the picker itself, never as a hidden raise."
  [state]
  (let [chosen (or (:word-count state) (get-in (spec state) [:words :default]))]
    (if-let [m (min-valid-word-count state)]
      (max chosen m)
      chosen)))

(defn preview
  "The live entropy readout for the CURRENT settings. Since the picker only
  offers counts that meet the floor, the readout is either a valid figure
  or :unreachable? — there is no raised state to warn about."
  [state]
  (let [sp (spec state)
        floor (:entropy-floor-bits sp)]
    (if (pin-mode? state)
      {:bits (entropy/digits-bits (effective-pin-length state)) :floor floor}
      (if (min-valid-word-count state)
        {:bits (entropy/passphrase-bits (filtered-list-size state)
                                        (effective-word-count state)
                                        (get-in sp [:digits :count]))
         :floor floor :unreachable? false}
        {:bits 0 :floor floor :unreachable? true}))))

(defn error->message
  "Maps a pwgen.core ex-data map to [i18n-key & args] for display; total
  over the engine's error vocabulary (the test suite proves it)."
  [{:keys [error] :as data}]
  (case error
    :word-count-out-of-range [:error/word-count-out-of-range (:min data) (:max data)]
    :length-out-of-range [:error/length-out-of-range (:min data) (:max data)]
    (:wordlist-too-small :entropy-floor-unreachable :generation-failed
     :separator-not-allowed :unknown-spec :invalid-spec :wordlist-tier-mismatch)
    [(keyword "error" (name error))]
    [:error/unexpected (str (or error data))]))

(defn generate
  "Runs the engine for the current state and returns the state with either
  :result or displayable :error data — never a thrown exception."
  [state]
  (let [sp (spec state)]
    (try
      (let [result (core/generate
                    (if (pin-mode? state)
                      {:spec sp :length (:pin-length state) :rng (:rng state)}
                      {:spec sp
                       :wordlist (get-in state [:list :words])
                       :name (:name state)
                       ;; Always explicit and always valid (the picker
                       ;; cannot select below the floor), so the engine's
                       ;; raise-or-refuse safety net never fires here.
                       :word-count (effective-word-count state)
                       :separator (:separator state)
                       :rng (:rng state)}))]
        (assoc state :result result :error nil :copied? false))
      (catch #?(:clj Exception :cljs :default) e
        (assoc state :result nil
               :error (or (ex-data e) {:error :unexpected :message (ex-message e)}))))))

(defn sanitize-settings
  "Saved settings come from a file or browser storage: user-editable,
  possibly stale from an older version. Every value is checked against
  what this version actually accepts; anything surprising falls back to
  the default rather than poisoning the session. Shell-specific keys
  (:auto-clear? :check-updates-on-start? :window) pass through for the
  desktop and are simply unused on the web."
  [saved]
  (let [spec-id (when (specs/get-spec (:spec-id saved)) (:spec-id saved))
        sp (specs/get-spec (or spec-id :ad-entra))
        {:keys [min max]} (:words sp)]
    {:spec-id spec-id
     :language (when (contains? i18n/translations (:language saved)) (:language saved))
     :wordlist-locale (:wordlist-locale saved)
     :word-count (when (and (int? (:word-count saved))
                            (<= min (:word-count saved) max))
                   (:word-count saved))
     :separator (when (some #(= (:separator saved) %)
                            (get-in sp [:separator :allowed]))
                  (:separator saved))
     :theme (if (#{:system :light :dark} (:theme saved)) (:theme saved) :system)
     :auto-clear? (if (some? (:auto-clear? saved)) (boolean (:auto-clear? saved)) true)
     :check-updates-on-start? (boolean (:check-updates-on-start? saved))
     :window (when (map? (:window saved)) (:window saved))}))
