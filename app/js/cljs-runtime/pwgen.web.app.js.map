(ns pwgen.web.app
  "Web shell wiring — the browser counterpart of pwgen.desktop.app: the
  only web namespace that touches the DOM, storage, the clipboard and the
  network (its own origin's static files, cached offline by the service
  worker — the page makes no other requests, SPEC §14).

  Word lists are STATIC ASSETS, not part of the JS bundle (decision M4):
  16 lists would roughly quadruple the bundle for data most sessions never
  touch. Instead every list is fetched from wordlists/ on demand and
  precached by sw.js at install, so the app is fully offline from the
  second visit while the bundle stays lean."
  (:require [cljs.tools.reader.edn :as edn]
            [cljs.tools.reader.reader-types :as reader-types]
            [pwgen.i18n :as i18n]
            [pwgen.rng :as rng]
            [pwgen.ui :as ui]
            [pwgen.web.logic :as logic]
            [pwgen.web.views :as views]
            [reagent.core :as r]
            [reagent.dom.client :as rdom]))

(defonce *state (r/atom nil))
(defonce root (atom nil))

(declare dispatch!)

;; ── Browser storage ────────────────────────────────────────────────────────
;;
;; Same contract as the desktop settings file: EDN, whitelist-sanitised on
;; load, and failure never worth telling anyone about — storage can be
;; absent or blocked (private windows), and the defaults are simply what a
;; first run looks like.

(def ^:private storage-key "pwgen-settings")

(defn- load-settings []
  (try
    (some-> (.getItem js/localStorage storage-key) edn/read-string)
    (catch :default _ nil)))

(defn- save-settings! [settings]
  (try
    (.setItem js/localStorage storage-key (pr-str settings))
    (catch :default _ nil)))

;; ── Effects ────────────────────────────────────────────────────────────────

(defn- read-two-forms
  "A generated list file is ;;-comments, a metadata map, then the words
  vector — two EDN forms. cljs.tools.reader reads them off one pushback
  reader, comments skipped, nothing evaluated."
  [content]
  (let [rdr (reader-types/string-push-back-reader content)]
    [(edn/read {:eof nil} rdr) (edn/read {:eof nil} rdr)]))

(defn- fetch-text [path ok! err!]
  (-> (js/fetch path)
      (.then (fn [resp] (if (.-ok resp) (.text resp) (throw (js/Error. path)))))
      (.then ok!)
      (.catch err!)))

(defmulti perform! (fn [[kind _]] kind))

(defmethod perform! :default [_] nil)

(defmethod perform! :reload-list
  [_]
  (let [s @*state]
    (when-not (ui/pin-mode? s)
      (let [tier (ui/wordlist-tier (:charset-tier (ui/spec s)))
            want (:wordlist-locale s)
            available (set (:wordlist-locales s))
            actual (if (contains? available want) want :en)
            fallback? (not= actual want)]
        (dispatch! {:event/type :list-loading})
        (fetch-text (str "wordlists/" (name actual) "-" (name tier) ".edn")
                    (fn [content]
                      (let [[meta-map words] (read-two-forms content)]
                        (dispatch! {:event/type :list-loaded
                                    :list {:words (vec words)
                                           :meta meta-map
                                           :fallback? fallback?}})))
                    (fn [_]
                      ;; A fetch that fails offline before first caching:
                      ;; surface as the unreachable state rather than a crash.
                      (dispatch! {:event/type :list-loaded
                                  :list {:words [] :meta nil :fallback? fallback?}})))))))

(defmethod perform! :persist
  [_]
  (save-settings! (logic/session-settings @*state)))

(defmethod perform! :copy
  [[_ password]]
  (when-let [clipboard (.-clipboard js/navigator)]
    (.writeText clipboard password))
  (js/setTimeout #(dispatch! {:event/type :copied-reset}) 2000))

(defmethod perform! :apply-theme
  [[_ theme]]
  ;; :system removes the override so the prefers-color-scheme media query
  ;; in app.css decides; an explicit choice pins it via data-theme.
  (let [el (.-documentElement js/document)]
    (case theme
      :system (.removeAttribute el "data-theme")
      (.setAttribute el "data-theme" (name theme)))))

(defmethod perform! :set-page-lang
  [_]
  (set! (.-lang (.-documentElement js/document)) (name (:locale @*state))))

;; ── Event delivery ─────────────────────────────────────────────────────────

(defn- handle-event [event]
  (let [{:keys [state effects]} (logic/handle @*state event)]
    (reset! *state state)
    (doseq [effect effects] (perform! effect))
    ;; Render NOW rather than on the next animation frame: browsers suspend
    ;; requestAnimationFrame in hidden tabs, so a list that finishes loading
    ;; in the background would otherwise show "Loading…" until the tab is
    ;; focused. The tree is small; synchronous flushing costs nothing here.
    (r/flush)))

(defn dispatch! [event] (handle-event event))

;; ── Startup ────────────────────────────────────────────────────────────────

(defn- register-service-worker! []
  (when-let [sw (.-serviceWorker js/navigator)]
    (-> (.register sw "sw.js")
        (.catch (fn [_] nil)))))

(defn- load-manifest! []
  (fetch-text "wordlists/manifest.edn"
              (fn [content]
                (let [[manifest] (read-two-forms content)
                      locales (->> (:lists manifest) (map :locale) distinct sort vec)]
                  (dispatch! {:event/type :manifest-loaded :locales locales})
                  (perform! [:reload-list])))
              (fn [_]
                ;; Even the manifest failing (offline, uncached) leaves a
                ;; working page: English only, list load will retry the
                ;; same error path.
                (dispatch! {:event/type :manifest-loaded :locales [:en]})
                (perform! [:reload-list]))))

(defn ^:export init []
  (reset! *state (assoc (logic/initial-state (load-settings))
                        :rng (rng/secure-rng)))
  (perform! [:apply-theme (:theme @*state)])
  (perform! [:set-page-lang])
  (register-service-worker!)
  (load-manifest!)
  (reset! root (rdom/create-root (.getElementById js/document "app")))
  (rdom/render @root [views/root *state dispatch!]))
